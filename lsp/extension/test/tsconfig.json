{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "../out/test",
    "rootDir": "../",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node", "bun-types"],
    "resolveJsonModule": true
  },
  "include": ["**/*", "../server/src/**/*"]
}